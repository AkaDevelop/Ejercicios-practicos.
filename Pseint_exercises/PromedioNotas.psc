Algoritmo Promedio_notas
	Definir nota1, nota2, nota3, nota4, nota5, total, promedio Como Real
	
	Escribir "||-Calculadora de promedio de 5 notas en total-||"
	
	Escribir "Digite la nota #1: "
	leer nota1
	Escribir "Digite la nota #2: "
	leer nota2
	Escribir "Digite la nota #3: "
	leer nota3
	Escribir "Digite la nota #4: "
	leer nota4
	Escribir "Digite la nota #5: "
	leer nota5
	
	total = nota1 + nota2 + nota3 + nota3 + nota5
	
	promedio = total / 5
	
	Imprimir "El resultado del promedio es igual a: ", promedio
	
	
FinAlgoritmo
